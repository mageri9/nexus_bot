BOT_TOKEN=ТВОЙ_ТОКЕН_БОТА
REDIS_URL=redis://localhost:6379/0
DEBUG=True
ADMIN_IDS=

# Сколько тиков StateCollector подряд должны подтвердить новый статус
# ресурса, прежде чем он закоммитится и уйдёт в EventBus. 1 = без дебаунса.
COLLECTOR_DEBOUNCE_TICKS=2

# Через сколько секунд без повторения того же fingerprint приложенческий
# инцидент закрывается автоматически (см. Error Registry / auto-recovery).
APP_ERROR_AUTO_RECOVERY_THRESHOLD=60

AITUNNEL_API_KEY=sk-aitunnel-ТВОЙ_КЛЮЧ_AITUNNEL
GITHUB_WEBHOOK_SECRET=
NEXUS_APP_SECRET=ТВОЙ_СЕКРЕТ_ДЛЯ_ПРИЛОЖЕНИЙ_SDK
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo